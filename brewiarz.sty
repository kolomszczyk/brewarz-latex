\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{brewiarz}[2026/08/25 Automatyczny pakiet do Jutrzni]


\RequirePackage{xcolor}
\RequirePackage{geometry}
\RequirePackage{environ} % Do tworzenia środowisk zbierających tekst



% Definicje kolorów liturgicznych
\definecolor{liturgicznyCzerwony}{HTML}{C0392B}

% Kolorowe symbole
\newcommand{\gwiazdka}{{\color{liturgicznyCzerwony}\textbf{*}}}
\newcommand{\krzyzyk}{{\color{liturgicznyCzerwony}\textbf{\dag}}}
\setlength{\parindent}{0pt}

% 1. Komendy strukturalne
\newcommand{\rubryka}[1]{%
    \par\vspace{0.5em}\noindent\textit{\color{liturgicznyCzerwony}#1}\par\vspace{0.5em}%
}

\newcommand{\wersik}[2]{%
    \par\noindent\textbf{W.} #1 \\
    \noindent\textbf{O.} #2\par
}

\newcommand{\antyfona}[1]{%
    \par\noindent\textbf{Ant.:} #1\par
}

% 2. Środowisko do psalmów z automatycznym formatowaniem linii
% Używa pakietu environ, żeby przetworzyć wklejony blok tekstu.
% Możemy tutaj zdefiniować, jak zachowują się znaki wewnątrz psalmu.

\ExplSyntaxOn
% Zabezpieczamy gwiazdkę i krzyżyk wewnątrz psalmu, żeby same się kolorowały
\NewDocumentEnvironment{psalm}{}{
    \par\vspace{0.3em}\noindent
    \ignorespaces
}{
    \par\vspace{0.3em}
}
\ExplSyntaxOff

% Alternatywne podejście: Makro parsujące pojedynczy wiersz psalmu.
% Użycie: \wiersz{Pierwsza część przed gwiazdką}{Druga część po gwiazdce}
% Dzięki temu LaTeX sam wyrówna obie części na szerokość kolumny!
\newcommand{\wpsalm}[2]{%
    \noindent #1 \gwiazdka \hspace{1em} #2 \par
}

% Wymagany pakiet do poziomej linii (jeśli go nie ma)
\RequirePackage{textcomp}

% Kolor liturgiczny (czerwony)
\definecolor{liturgicznyCzerwony}{HTML}{C0392B}
\newcommand{\czerwony}[1]{{\color{liturgicznyCzerwony}#1}}


% 1. Główny nagłówek (Tytuł + Data)
\newcommand{\tytulgodziny}[2]{%
    \begin{center}
        {\czerwony{\Huge\bfseries #1}}\\[0.4em]
        {\czerwony{\LARGE #2}}
        \par\vspace{0.8em}
        {\czerwony{\rule{0.8\textwidth}{0.5pt}}} % Pozioma linia
    \end{center}
    \vspace{1em}
}

\newcommand{\wezwanieKrotkie}{
    \krzyzyk{}

K. † Boże, wejrzyj ku wspomożeniu memu.
W. Panie, pośpiesz ku ratunkowi memu.
Chwała Ojcu i Synowi, i Duchowi Świętemu.
Jak była na początku, teraz i zawsze,
i na wieki wieków. Amen. Alleluja.
}

% 2. Początkowe wezwanie z K. i W. oraz czerwonym krzyżykiem
\newcommand{\poczatek}[2]{%
    \par\noindent\czerwony{K. \dag} #1 \\
    \noindent\czerwony{W.} #2\par
    \vspace{0.5em}
}


% 3. Doksologia (Chwała Ojcu...)
\newcommand{\doksologia}{%
    \par\vspace{0.5em}
    \noindent Chwała Ojcu i Synowi, \gwi i Duchowi Świętemu. \\
    \noindent Jak była na początku, teraz i zawsze, \\
    \noindent i na wieki wieków. Amen. \czerwony{Alleluja.}
    \par\vspace{0.5em}
}